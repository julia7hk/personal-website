---
// Rendered by both layouts, so every page (including blog posts) ends with a
// way back into the rest of the site.
const year = new Date().getFullYear();

// Series list is derived from the posts themselves, mirroring blog.astro:
// group by the title prefix before " - ", and only treat a group as a series
// if it has more than one post (a lone "git reflog - ..." is Miscellaneous).
const posts = Object.values(
	import.meta.glob('../pages/blog/**/*.md', { eager: true })
) as Array<{ frontmatter: { title: string; date: string; dayNumber?: number } }>;

const groups = new Map<string, { count: number; latest: number; isSeries: boolean }>();
posts.forEach(({ frontmatter }) => {
	const title = frontmatter.title ?? '';
	const name = title.includes(' - ') ? title.split(' - ')[0].trim() : title;
	const date = new Date(frontmatter.date).getTime();
	const prev = groups.get(name);
	groups.set(name, {
		count: (prev?.count ?? 0) + 1,
		latest: Math.max(prev?.latest ?? 0, date),
		isSeries: (prev?.count ?? 0) + 1 > 1 || frontmatter.dayNumber != null || !!prev?.isSeries,
	});
});

const series = [...groups.entries()]
	.filter(([, g]) => g.isSeries)
	.sort((a, b) => b[1].latest - a[1].latest)
	.map(([name]) => ({ name, id: name.toLowerCase().replace(/\s+/g, '-') }));

