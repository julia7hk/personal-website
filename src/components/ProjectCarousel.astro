---
import { Image } from 'astro:assets';

interface Slide {
	src: ImageMetadata;
	alt: string;
	caption: string;
	href?: string;
}

interface Props {
	slides: Slide[];
	label: string;
}

const { slides, label } = Astro.props;
---

<div class="carousel" data-carousel aria-roledescription="carousel" aria-label={label}>
	<div class="carousel-frame">
		<div class="carousel-track" data-carousel-track tabindex="0">
			{slides.map((slide, i) => (
				<figure class="carousel-slide">
					<Image
						src={slide.src}
						alt={slide.alt}
						widths={[640, 1000, 1800]}
						sizes="(max-width: 768px) 92vw, 900px"
						loading={i === 0 ? 'eager' : 'lazy'}
					/>
					<figcaption>
						{slide.caption}
						{slide.href && (
							<a href={slide.href} target="_blank" rel="noopener">Open live &rarr;</a>
						)}
					</figcaption>
				</figure>
			))}
		</div>
		<button class="carousel-arrow prev" type="button" data-carousel-prev aria-label="Previous screenshot">&lsaquo;</button>
		<button class="carousel-arrow next" type="button" data-carousel-next aria-label="Next screenshot">&rsaquo;</button>
	</div>
	<div class="carousel-nav">
		<div class="carousel-dots" data-carousel-dots>
			{slides.map((_, i) => (
				<button class="carousel-dot" type="button" data-carousel-dot={i} aria-label={`Go to screenshot ${i + 1}`}></button>
			))}
		</div>
		<span class="carousel-count" data-carousel-count aria-live="polite">1 / {slides.length}</span>
	</div>
</div>

<style>
	.carousel {
		margin-bottom: 1.5rem;
	}

	.carousel-frame {
		position: relative;
	}

	.carousel-track {
		display: flex;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scroll-behavior: smooth;
		border: 1px solid #e4e7ee;
		border-radius: 6px;
		background: #fff;
		scrollbar-width: none;
	}

	.carousel-track::-webkit-scrollbar {
		display: none;
	}

	.carousel-track:focus-visible {
		outline: 2px solid #5372aa;
		outline-offset: 2px;
	}

	.carousel-slide {
		flex: 0 0 100%;
		scroll-snap-align: start;
		margin: 0;
		min-width: 0;
	}

	/* The <Image> component's <img> is not scoped by this component, so target it globally. */
	.carousel-slide :global(img) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		object-position: top center;
		border-bottom: 1px solid #eef0f4;
	}

	.carousel-slide figcaption {
		padding: 0.7rem 0.9rem;
		font-size: 0.78rem;
		line-height: 1.55;
		color: #6a6a6a;
		min-height: 3.4rem;
	}

	.carousel-slide figcaption a {
		color: #5372aa;
		text-decoration: none;
		white-space: nowrap;
		margin-left: 0.4rem;
	}

	.carousel-slide figcaption a:hover {
		text-decoration: underline;
	}

	/* Arrows are a JS enhancement — hidden until the script marks the carousel ready. */
	.carousel-arrow {
		display: none;
		position: absolute;
		top: 0;
		transform: translateY(0);
		height: calc(100% - 3.4rem);
		width: 2.75rem;
		border: none;
		background: transparent;
		color: #2a2a2a;
		font-size: 1.6rem;
		line-height: 1;
		cursor: pointer;
		opacity: 0;
		transition: opacity 0.2s ease;
	}

	.carousel[data-ready] .carousel-arrow {
		display: block;
	}

	.carousel-frame:hover .carousel-arrow,
	.carousel-arrow:focus-visible {
		opacity: 1;
	}

	.carousel-arrow::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
	}

	.carousel-arrow.prev {
		left: 0;
		border-radius: 6px 0 0 0;
		background: linear-gradient(to right, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0));
	}

	.carousel-arrow.next {
		right: 0;
		border-radius: 0 6px 0 0;
		background: linear-gradient(to left, rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0));
	}

	.carousel-arrow[disabled] {
		opacity: 0 !important;
		pointer-events: none;
	}

	.carousel-nav {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-top: 0.7rem;
	}

	.carousel-dots {
		display: flex;
		gap: 0.4rem;
	}

	.carousel-dot {
		width: 7px;
		height: 7px;
		padding: 0;
		border: none;
		border-radius: 50%;
		background: #d4d9e4;
		cursor: pointer;
		transition: background 0.2s ease, transform 0.2s ease;
	}

	.carousel-dot[aria-current='true'] {
		background: #5372aa;
		transform: scale(1.3);
	}

	.carousel-count {
		font-size: 0.72rem;
		color: #8a8a8a;
		margin-left: auto;
	}

	@media (max-width: 768px) {
		.carousel-slide :global(img) {
			aspect-ratio: 4 / 3;
		}

		.carousel-slide figcaption {
			padding: 0.55rem 0.7rem;
			font-size: 0.72rem;
			min-height: 3.8rem;
		}

		.carousel-arrow {
			width: 2.25rem;
			height: calc(100% - 3.8rem);
			opacity: 1;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.carousel-track {
			scroll-behavior: auto;
		}
	}
</style>

<script>
	function setupCarousel(root: HTMLElement) {
		const track = root.querySelector<HTMLElement>('[data-carousel-track]');
		const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));
		const count = root.querySelector<HTMLElement>('[data-carousel-count]');
		const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
		const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
		if (!track) return;

		const total = dots.length;
		const indexOf = () => Math.round(track.scrollLeft / track.clientWidth);

		const sync = () => {
			const i = Math.min(Math.max(indexOf(), 0), total - 1);
			dots.forEach((dot, d) => dot.setAttribute('aria-current', String(d === i)));
			if (count) count.textContent = `${i + 1} / ${total}`;
			if (prev) prev.disabled = i === 0;
			if (next) next.disabled = i === total - 1;
		};

		const goTo = (i: number) => {
			track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' });
		};

		let queued = false;
		track.addEventListener('scroll', () => {
			if (queued) return;
			queued = true;
			requestAnimationFrame(() => {
				queued = false;
				sync();
			});
		});

		prev?.addEventListener('click', () => goTo(indexOf() - 1));
		next?.addEventListener('click', () => goTo(indexOf() + 1));
		dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
		window.addEventListener('resize', sync);

		root.setAttribute('data-ready', '');
		sync();
	}

	document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(setupCarousel);
</script>
