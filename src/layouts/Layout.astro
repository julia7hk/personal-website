---
import Clarity from '../components/Clarity.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

export interface Props {
	title?: string;
	description?: string;
}

const { title = "Julia Kang - CS & AI Student", description = "Computer Science and AI student at Purdue University with experience in full-stack development, machine learning, and biomedical research. Seeking Summer 2027 internships and 2027 new-grad roles in the Bay Area." } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Mono:wght@400;700&display=swap" rel="stylesheet">
		<Clarity />
	</head>
	<body>
		<Navbar />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		font-family: 'Atkinson Hyperlegible Mono', 'Courier New', monospace;
		font-size: 16px;
		line-height: 1.65;
	}

	body {
		background: #fafaf8;
		min-height: 100vh;
		color: #2a2a2a;
	}

	main {
		margin-top: 60px;
		min-height: calc(100vh - 60px);
	}

</style>
